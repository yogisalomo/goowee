{"nodes": [{"id": "docs_guides_concepts_overview", "label": "Concepts guide \u2014 goowee mental model", "file_type": "document", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guides_concepts_signal", "label": "Signal \u2014 fine-grained reactivity unit", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A signal bound to a DOM node updates only that node \u2014 there is no re-render, no virtual DOM, no component re-run. This is fine-grained reactivity."}, {"id": "docs_guides_concepts_component", "label": "Run-once component (setup, not render)", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The component body runs exactly once on mount (Solid-style, not React); it is setup not render. Consequences: no hook-ordering rules, props that change are passed as signals, and a matched component's state and effects survive parent re-renders."}, {"id": "docs_guides_concepts_computed", "label": "Computed \u2014 derived read-only signal", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recomputes only when a listed dependency changes; read-only. Use instead of recomputing in the run-once body."}, {"id": "docs_guides_concepts_control_flow", "label": "Declarative control flow (Show/ShowElse/Switch/For/VirtualList)", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the component body runs once, plain if/for cannot react to signal changes; declarative control flow with stable keys re-renders the affected scope while preserving row identity and element state."}, {"id": "docs_guides_concepts_effects", "label": "Effects with explicit deps (OnMount/Watch/UseEffect)", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All effects declare dependencies explicitly \u2014 there is no auto-tracking. OnMount is client-only (never runs during SSR); cleanup functions run on change/unmount to avoid goroutine leaks."}, {"id": "docs_guides_concepts_schedule", "label": "Off-loop updates via core.Schedule", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timers, goroutines, network callbacks and channel receives run outside the render loop and must not set signals directly \u2014 that races the renderer. Schedule enqueues the update on the frame queue, drained once per frame."}, {"id": "docs_guides_concepts_useresource", "label": "UseResource \u2014 async data loading", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns Data/Loading/Err signals plus Refetch, runs the fetch in a goroutine and applies the result safely. Fetching is client-side, so SSR renders the loading state and the client fills it after hydration."}, {"id": "docs_guides_concepts_error_boundary", "label": "ErrorBoundary \u2014 contains render-time panics", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catches a panic while rendering a child and renders a fallback so the rest of the page stays intact; update-time panics keep the subtree's previous state and are logged."}, {"id": "docs_guides_concepts_ssr_hydration", "label": "SSR + hydration", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SSR emits data-node-id attributes and text markers; the client detects the server DOM and hydrates (claims nodes, wires handlers) instead of rebuilding. Hydration trusts server and client to produce identical markup; a structural mismatch logs a console.error and recovers best-effort."}, {"id": "docs_guides_concepts_dynamic", "label": "h.Dynamic \u2014 hydration escape hatch", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps a legitimately non-deterministic subtree (dates, locale, per-request data) so the client's value wins over the server's on hydration, keeping the rest of the markup deterministic."}, {"id": "docs_guides_concepts_routing", "label": "Client-side routing (path-based, History API)", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matching is deterministic: exact match wins, then most-specific param/prefix. ParamSignal binds reactively (updates in place, no remount); Param is a one-shot read for handlers."}, {"id": "docs_guides_concepts_bindings", "label": "Two-way bindings (BindValue/BindChecked/BindSelect)", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guides_concepts_refs_portals", "label": "Refs & portals \u2014 imperative DOM / out-of-tree render", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refs give imperative DOM access (Focus/Blur/Click/ScrollIntoView) instead of reaching into syscall/js; portals render modals/tooltips outside the current subtree."}, {"id": "docs_guides_concepts_events", "label": "Events (OnClick/OnInput/OnSubmit/\u2026, OnClickE)", "file_type": "rationale", "source_file": "docs/guides/concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_guides_concepts_overview", "target": "docs_api_reference_public_surface", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_signal", "target": "docs_api_reference_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_computed", "target": "docs_api_reference_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_schedule", "target": "docs_api_reference_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_effects", "target": "docs_api_reference_hooks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_useresource", "target": "docs_api_reference_hooks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "sourc