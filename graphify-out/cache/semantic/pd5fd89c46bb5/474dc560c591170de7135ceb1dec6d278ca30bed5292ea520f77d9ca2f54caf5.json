s_ssr_hydration", "target": "docs_api_reference_bridge", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_component", "target": "docs_guides_concepts_control_flow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_component", "target": "docs_guides_concepts_signal", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_ssr_hydration", "target": "docs_guides_concepts_dynamic", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_signal", "target": "docs_guides_concepts_computed", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_schedule", "target": "docs_guides_concepts_useresource", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_guides_concepts_dynamic", "target": "docs_guides_concepts_effects", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.7, "source_file": "docs/guides/concepts.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ssr_hydration_flow", "label": "SSR and hydration flow", "nodes": ["docs_api_reference_ssr", "docs_guides_concepts_ssr_hydration", "docs_api_reference_bridge", "docs_guides_concepts_dynamic"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/guides/concepts.md"}]}